#!/usr/bin/env groovy

multibranchPipelineJob('CI-GL-Test-K8s') {
  displayName('CI - GL-Test - K8s validation')
  description('CI - GL-Test - K8s manifests validation')
  branchSources {
    github {
      id('120190') // IMPORTANT: use a constant and unique identifier
      scanCredentialsId('git-snwbr-app')
      checkoutCredentialsId('git-gl-test-ssh')
      repository('git@github.com:snwbr/gl-test.git')
      includes('*')
    }
  }
  orphanedItemStrategy {
    discardOldItems {
      numToKeep(2)
      daysToKeep(2)
    }
  }
  factory {
    workflowBranchProjectFactory {
      scriptPath('k8s/CI.Jenkinsfile')
    }
  }
  triggers {
    periodic(1)
  }
}
