#!/usr/bin/env groovy

multibranchPipelineJob('CD-GL-Test-K8s') {
  displayName('GL-Test repo - K8s deployment')
  description('GL-Test repo - K8s manifests deployment')
  branchSources {
    git {
      id('010990') // IMPORTANT: use a constant and unique identifier
      remote('git@github.com:snwbr/gl-test.git')
      credentialsId('git-gl-test-ssh')
      includes('*')
    }
  }
  orphanedItemStrategy {
    discardOldItems {
      numToKeep(5)
      daysToKeep(5)
    }
  }
  factory {
    workflowBranchProjectFactory {
      scriptPath('k8s/CD.Jenkinsfile')
    }
  }
}
