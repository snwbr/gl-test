#!/usr/bin/env groovy

multibranchPipelineJob('CD-GL-Test-K8s') {
  displayName('CD - GL-Test - K8s deployment')
  description('CD - GL-Test - K8s manifests deployment')
  branchSources {
    github {
      id('010990') // IMPORTANT: use a constant and unique identifier
      scanCredentialsId('git-snwbr-app')
      checkoutCredentialsId('git-gl-test-ssh')
      repository('gl-test')
      includes('main')
      repoOwner('snwbr')
    }
  }
  orphanedItemStrategy {
    discardOldItems {
      numToKeep(2)
      daysToKeep(2)
    }
  }
  factory {
    workflowBranchProjectFactory {
      scriptPath('k8s/CD.Jenkinsfile')
    }
  }
  triggers {
    periodicFolderTrigger {
      interval("1m")
    }
  }
}
